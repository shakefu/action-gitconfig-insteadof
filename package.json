{
  "name": "action-gitconfig-insteadof",
  "version": "1.0.0",
  "description": "GitHub Action to configure gitconfig insteadOf rules",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "prepare": "rm -rf dist && ncc build index.js -o dist/main --source-map --license licenses.txt && ncc build remove.js -o dist/post --source-map",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "all": "npm run lint && npm run prepare && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shakefu/action-gitconfig-insteadof.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shakefu/action-gitconfig-insteadof/issues"
  },
  "homepage": "https://github.com/shakefu/action-gitconfig-insteadof#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2"
  },
  "type": "module"
}
